# Copy to .env and set a unique ADMIN_TOKEN. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Branding
SITE_NAME=Is it us or them?
ORG_NAME=IT

# Monitoring
POLL_INTERVAL_SECONDS=60
FETCH_TIMEOUT_MS=10000
SEED_SERVICES=true
# Empty: max(60, 3 * poll interval, 2 * timeout in seconds); defaults to 180s.
# Explicit values must cover one poll interval plus the timeout, and be <= 30 days.
STATUS_STALE_AFTER_SECONDS=

# Exact origins mapped to permitted CIDRs for private/nonstandard-port checks.
# Keep approvals narrow. All DNS answers must match. Metadata remains blocked.
# Example: CHECK_ALLOWED_TARGETS={"https://wiki.internal:8443":["10.20.0.25/32"]}
CHECK_ALLOWED_TARGETS={}
# HTTP_PROXY / HTTPS_PROXY / ALL_PROXY are not supported by the pinned transport.
# See docs/MONITORING_SECURITY.md before upgrading a proxy-dependent deployment.

# Compose host binding
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Optional Slack slash-command verification
SLACK_SIGNING_SECRET=
