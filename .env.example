# Copy to .env and set a unique, strong ADMIN_TOKEN before using Compose.
# Generate one locally with: openssl rand -hex 32
ADMIN_TOKEN=

# Branding
SITE_NAME=Is it us or them?
ORG_NAME=IT

# Monitoring
POLL_INTERVAL_SECONDS=60
FETCH_TIMEOUT_MS=10000
SEED_SERVICES=true

# Docker Compose: publish on loopback only unless intentionally changed.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Optional Slack slash-command verification
SLACK_SIGNING_SECRET=
