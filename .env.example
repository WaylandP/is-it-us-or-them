# Port the web server listens on
PORT=3000

# Token required for the admin UI and write API calls.
# If unset, a random token is generated at startup and printed to the log.
ADMIN_TOKEN=change-me

# Where the JSON data file lives (services, maintenance, announcements)
DATA_DIR=./data

# How often to poll vendor feeds, in seconds
POLL_INTERVAL_SECONDS=60

# Per-request timeout for vendor feeds, in milliseconds
FETCH_TIMEOUT_MS=10000

# Branding
SITE_NAME=Is it us or them?
ORG_NAME=IT

# Optional: verify Slack slash-command requests (see README)
SLACK_SIGNING_SECRET=
